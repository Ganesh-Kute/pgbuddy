{
  "appId": "com.pgbuddy.manager",
  "appName": "Mauli PG",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*.razorpay.com"]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#08306a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#08306a"
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#ffffff"
  }
}
